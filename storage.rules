rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// MiNegocio POS — Reglas de seguridad de Firebase Storage
//
// Estructura:
//   stores/{storeId}/products/{filename}  → imágenes de productos
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    match /stores/{storeId}/products/{filename} {
      // Cualquier usuario autenticado puede ver las imágenes (catálogo público de la tienda)
      allow read:  if request.auth != null;

      // Solo el admin puede subir/borrar imágenes
      // Límite: 2MB por archivo, solo imágenes
      allow write: if request.auth != null
        && request.auth.token.role == 'admin'
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null
        && request.auth.token.role == 'admin';
    }
  }
}
